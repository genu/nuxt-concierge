{
  "name": "nuxt-concierge",
  "version": "2.0.0-alpha.1",
  "description": "Background jobs, queues and workers for Nuxt",
  "repository": "https://github.com/genu/nuxt-concierge",
  "license": "MIT",
  "type": "module",
  "configKey": "concierge",
  "compatibility": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "tag": "next",
    "access": "public"
  },
  "scripts": {
    "build:client": "pnpm --filter @nuxt-concierge/client build",
    "dev:client": "pnpm --filter @nuxt-concierge/client dev",
    "prepack": "nuxt-module-build build && pnpm build:client",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && pnpm build:client",
    "docs:build": "nuxi generate docs",
    "docs:preview": "nuxi preview docs",
    "docs:dev": "nuxi dev docs",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck playground",
    "typecheck:public": "tsc --noEmit -p test/types/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:lifecycle": "vitest run --config vitest.lifecycle.config.ts",
    "test:types": "vitest run --config vitest.types.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "vue-demi"
    ],
    "packageExtensions": {
      "@nuxt/ui-pro@0.6.1": {
        "dependencies": {
          "@nuxt/kit": "3.10.0"
        }
      }
    }
  },
  "dependencies": {
    "@nuxt/devtools-kit": "3.4.1",
    "@nuxt/kit": "4.5.2",
    "@standard-schema/spec": "1.1.0",
    "bullmq": "5.63.0",
    "consola": "3.4.2",
    "defu": "6.1.7",
    "devalue": "5.4.1",
    "fast-glob": "3.3.3",
    "ioredis": "5.9.0",
    "ufo": "1.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.16.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "4.1.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "eslint-plugin-vitest": "0.5.4",
    "nuxt": "4.5.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "zod": "4.4.3"
  }
}
